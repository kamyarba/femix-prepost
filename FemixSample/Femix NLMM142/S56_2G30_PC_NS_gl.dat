</LOAD_CASE_PARAMETERS>

      <POINT_LOADS>
        ## Point loads (global coordinate system)
        COUNT = 1 ; # N. of point loads

        ## Content of each column:
        #  A -> Counter (or counter range)
        #  B -> Loaded point (or loaded point range)
        #  C -> Force - XG1
        #  D -> Force - XG2
        #  E -> Force - XG3
        #  F -> Moment - XG1
        #  G -> Moment - XG2
        #  H -> Moment - XG3
        # A         B                 C                 D                 E                 F              G           H
        # --------------------------------------------------------------------------------------------------------------------------
        1         1007              0.00              0.0              -1.00             0.00            0.00        0.00 ;

      </POINT_LOADS>

    </LOAD_CASE>

  </LOAD>

  <LOAD_CASE_COMBINATIONS>

