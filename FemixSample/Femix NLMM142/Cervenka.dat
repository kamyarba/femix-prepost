    #    H		      I
    2.45	    _TRILINEAR
    # -------------------------------------------------------------------------------------------------------------------

    #   J			   K		    	L 	             M             N         O             	P
    0.2  		 0.7			0.75			    0.2  	 0.0	   	0.0  	       0.04
    #   0.045  		 0.78			0.058			    0.90	 0.15	   	0.30  	        5.5
