<FEMIX_DATA_FILE_V4.0>

<MAIN_PARAMETERS>
  MAIN_TITLE = Mesh ;

  ANALYSIS_TYPE = _STATIC ;
  MATERIALLY_NONLINEAR_PROBLEM = _Y ;
  GEOMETRICALLY_NONLINEAR_PROBLEM = _N ;

  NUMBER_OF_PHASES = 1 ;
  NUMBER_OF_LOAD_CASES = 2 ;
  NUMBER_OF_COMBINATIONS = 80 ;

  STIFFNESS_MATRIX_STORAGE_TECHNIQUE = _SYMMETRIC_SPARSE ;
  SYSTEM_LIN_EQ_ALGORITHM = _ITERATIVE_JPCG ;
  PRECONDITIONED_RESIDUAL_DECAY =  1.0000e-006 ;
  #   MAXIMUM_NUMBER_OF_ARC_LENGTH_COMBINATIONS = 1000 ;

    ITERATIVE_ALGORITHM = _NEWTON_RAPHSON_MOD_1 ;
#  ITERATIVE_ALGORITHM = _NEWTON_RAPHSON_STD ;
   CONVERGENCE_CRITERION = _FORCE_NORM ;
  TOLERANCE_IN_EACH_COMBINATION =  1.0000e-003 ;
  MAXIMUM_NUMBER_OF_ITERATIONS_IN_EACH_COMBINATION = 1000 ;
  NUMBER_OF_COMBINATIONS_BEFORE_RESTART = 0 ;

  ARC_LENGTH = _N ;

  LINE_SEARCH = _N ;

  PATH_BEHAVIOR = _INDEPENDENT ;
</MAIN_PARAMETERS>

<MESH>

<GROUP_NAMES>
