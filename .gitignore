# Local deployment binaries and dependencies have not been cleared for redistribution.
# The current classic project references selected assemblies under Exe/, so a clone
# will require approved dependency files there or updated reproducible references.
/Exe/**
!/Exe/.gitkeep

# Locally generated installer; distribute as a reviewed GitHub Release asset instead.
/Femix_PrePost-Setup.msi

# Local presentation PDF is not part of the source archive by default.
/Femix Pre-Post.pdf

# Sample inputs are excluded until their provenance and redistribution rights are confirmed.
/FemixSample/**
!/FemixSample/.gitkeep
