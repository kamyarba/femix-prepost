      2         6  _D3       -100.00 ;
      3         7  _D3       -100.00 ;
      4         8  _D3       -100.00 ;
    </PRESCRIBED_DISPLACEMENTS>
    
  </LOAD_CASE>
  
</LOAD>

<LOAD_CASE_COMBINATIONS>

  <COMBINATION>

    <COMBINATION_PARAMETERS>
      COMBINATION_NUMBER = 1 ;
      COMBINATION_TITLE = Presc. Displ. ;
      COMBINATION_GROUP = MY_GROUP ;
      PHASE_NUMBER =  1 ;
    </COMBINATION_PARAMETERS>

    <LOAD_CASE_FACTORS>
